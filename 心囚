        </div>

        <!-- 遊戲主畫面 -->
        <div id="game-screen" class="screen-hidden h-full flex flex-col lg:grid lg:grid-cols-12 gap-4">
            
            <!-- 資訊與控制欄 (平板/手機位於上方，電腦位於左側) -->
            <div class="lg:col-span-4 flex flex-col gap-3 max-h-[38vh] lg:max-h-full">
                <!-- 控制區：現在輪到 & 骰子 (核心操作位) -->
                <div class="bg-white p-4 rounded-2xl shadow-md border-b-4 border-indigo-200 text-center flex items-center justify-between lg:flex-col lg:justify-center">
                    <div class="flex flex-col items-start lg:items-center lg:mb-4">
                        <span class="text-gray-400 text-[10px] font-black uppercase tracking-widest mb-1">現在輪到</span>
                        <div id="current-player-info" class="px-6 py-2 rounded-xl text-white font-black text-xl shadow-md transition-all duration-300">
                            1號
                        </div>
                    </div>
                    
                    <div class="flex items-center gap-4">
                        <div id="dice" class="dice" onclick="rollDice()">🎲</div>
                        <div class="text-left">
                            <p class="text-gray-400 text-[10px] font-black uppercase leading-none">擲骰結果</p>
                            <div id="roll-result" class="font-black text-3xl text-indigo-600 italic h-8 leading-tight"></div>
                        </div>
                    </div>
                </div>

                <!-- 排行榜 (縮小版，確保不擋住棋盤) -->
                <div class="bg-white p-3 rounded-2xl shadow-sm border border-gray-100 flex-1 overflow-hidden flex flex-col">
                    <div class="flex justify-between items-center mb-1.5">
                        <h2 class="text-sm font-black text-gray-800">🏆 即時積分排行</h2>
                        <button onclick="confirmEnd()" class="bg-red-500 text-white text-[9px] px-2 py-1 rounded-lg font-black shadow-sm">結束結算</button>
                    </div>
                    <div id="player-stats" class="space-y-1 overflow-y-auto flex-1 scroll-hide">
