        let selectedPunishments = [];
        let rewardRankMap = { 1: "無", 2: "無" };
        let penaltyRankMap = { last: "無", secondLast: "無" };
        let isRolling = false;
        const TOTAL_CELLS = 20;

        const CHANCE_CELLS = [3, 10, 17]; // 猜拳
        const FATE_CELLS = [6, 13, 19];   // 命運事件

        window.onload = () => { renderPlayerInputs(); };

        function renderPlayerInputs() {
            const count = parseInt(document.getElementById('player-count').value);
            const container = document.getElementById('player-inputs');
            container.innerHTML = '';
            for(let i=0; i<count; i++) {
                container.innerHTML += `
                    <div class="flex items-center gap-2 bg-indigo-50 p-2 rounded-xl border border-indigo-100 shadow-inner">
                        <span class="text-[10px] font-black text-indigo-300">P${i+1}</span>
                        <input type="number" id="seat-p${i}" placeholder="座號" class="w-full p-1.5 border rounded-lg text-sm font-black outline-none bg-white">
                    </div>
                `;
            }
        }

        function goToStep2() {
            const count = parseInt(document.getElementById('player-count').value);
            let seats = [];
            for(let i=0; i<count; i++) {
                const val = document.getElementById(`seat-p${i}`).value;
                if(!val) { showModal("提示", "請輸入所有玩家的座號！", "bg-yellow-500"); return; }
                seats.push(val);
            }
            if(new Set(seats).size !== seats.length) { showModal("提示", "座號不可重複！", "bg-yellow-500"); return; }
            
            const desc = document.getElementById('step2-desc');
            const penaltyTitle = document.getElementById('penalty-title');
            const secondLastRow = document.getElementById('second-last-penalty-row');
            
            if (count === 3) {
                desc.innerText = "設定 2 個獎勵與 1 個懲罰";
                penaltyTitle.innerText = "⚡ 選擇 1 個懲罰";
                secondLastRow.classList.add('screen-hidden');
            } else {
                desc.innerText = "設定 2 個獎勵與 2 個懲罰";
                penaltyTitle.innerText = "⚡ 選擇 2 個懲罰";
                secondLastRow.classList.remove('screen-hidden');
            }

            document.getElementById('setup-step-1').classList.add('screen-hidden');
            document.getElementById('setup-step-2').classList.remove('screen-hidden');
            renderSetupLists();
        }

        function backToStep1() {
            document.getElementById('setup-step-2').classList.add('screen-hidden');
            document.getElementById('setup-step-1').classList.remove('screen-hidden');
        }

        function addCustomPenalty() {
            const input = document.getElementById('custom-penalty-input');
            if (input.value.trim()) { punishmentsPool.push(input.value.trim()); input.value = ''; renderSetupLists(); }
        }

        function renderSetupLists() {
            const rList = document.getElementById('rewards-list'), pList = document.getElementById('punishments-list');
            rList.innerHTML = initialRewards.map(r => `<label class="flex items-center space-x-1.5 bg-white p-1.5 rounded-lg border text-[10px] cursor-pointer shadow-sm"><input type="checkbox" name="reward" value="${r}" onchange="handleRewardChange()" class="w-3 h-3 text-green-600"> <span class="truncate">${r}</span></label>`).join('');
            pList.innerHTML = punishmentsPool.map(p => `<label class="flex items-center space-x-1.5 bg-white p-1.5 rounded-lg border text-[10px] cursor-pointer shadow-sm"><input type="checkbox" name="punishment" value="${p}" onchange="handlePenaltyChange()" class="w-3 h-3 text-red-600"> <span class="truncate">${p}</span></label>`).join('');
        }

        function handleRewardChange() {
            const selected = Array.from(document.querySelectorAll('input[name="reward"]:checked')).map(el => el.value);
            if (selected.length > 2) { document.querySelectorAll('input[name="reward"]:checked')[0].checked = false; handleRewardChange(); return; }
            selectedRewards = selected;
            const div = document.getElementById('reward-assignment');
            if (selected.length === 2) {
                div.classList.remove('hidden');
                document.getElementById('rank1-reward').innerHTML = selected.map(r => `<option value="${r}">${r}</option>`).join('');
                document.getElementById('rank2-reward').innerHTML = selected.map(r => `<option value="${r}">${r}</option>`).join('');
                document.getElementById('rank2-reward').selectedIndex = 1;
            } else div.classList.add('hidden');
        }

        function handlePenaltyChange() {
            const count = parseInt(document.getElementById('player-count').value);
            const limit = (count === 3) ? 1 : 2;
            const selected = Array.from(document.querySelectorAll('input[name="punishment"]:checked')).map(el => el.value);
            
            if (selected.length > limit) { 
                document.querySelectorAll('input[name="punishment"]:checked')[0].checked = false; 
                handlePenaltyChange(); 
                return; 
            }
            
            selectedPunishments = selected;
            const div = document.getElementById('penalty-assignment');
            if (selected.length === limit) {
                div.classList.remove('hidden');
                document.getElementById('rank-last-penalty').innerHTML = selected.map(p => `<option value="${p}">${p}</option>`).join('');
                if (limit === 2) {
                    document.getElementById('rank-second-last-penalty').innerHTML = selected.map(p => `<option value="${p}">${p}</option>`).join('');
                    document.getElementById('rank-second-last-penalty').selectedIndex = 1;
                }
            } else div.classList.add('hidden');
        }

        function preStartDraw() {
            const count = parseInt(document.getElementById('player-count').value);
            const penaltyLimit = (count === 3) ? 1 : 2;
            
            if (selectedRewards.length < 2 || selectedPunishments.length < penaltyLimit) { 
                showModal("設定未完成", `請選好獎懲項目並分配排名！`, "bg-yellow-500"); 
                return; 
            }
            
            rewardRankMap[1] = document.getElementById('rank1-reward').value;
            rewardRankMap[2] = document.getElementById('rank2-reward').value;
            penaltyRankMap.last = document.getElementById('rank-last-penalty').value;
            if (count > 3) penaltyRankMap.secondLast = document.getElementById('rank-second-last-penalty').value;

            let rawSeats = []; for(let i=0; i<count; i++) rawSeats.push(document.getElementById(`seat-p${i}`).value);
            
            let drawBody = `<div class="flex flex-col items-center gap-4 py-8"><p class="text-gray-500 font-bold mb-4 italic text-sm">🎲 正在決定出發順序...</p><div id="shuffle-display" class="flex flex-wrap justify-center gap-3">${rawSeats.map(s => `<div class="w-12 h-12 bg-indigo-100 rounded-xl flex items-center justify-center font-black text-indigo-600 border-2 border-indigo-200">${s}</div>`).join('')}</div></div>`;
            showModal("順序抽籤", drawBody, "bg-indigo-600", null, true);
            
            let counter = 0;
            const interval = setInterval(() => {
                const disp = document.getElementById('shuffle-display'); if(!disp) return clearInterval(interval);
                const items = Array.from(disp.children).sort(() => Math.random() - 0.5); disp.innerHTML = ''; items.forEach(it => disp.appendChild(it));
                if(++counter > 12) {
                    clearInterval(interval);
                    const shuffled = rawSeats.sort(() => Math.random() - 0.5);
                    const colors = ['#f43f5e', '#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#06b6d4', '#475569'];
                    players = shuffled.map((s, idx) => ({ id: idx, seatNo: s, color: colors[idx % colors.length], pos: 0, score: 0, skipNextTurn: false }));
                    
                    disp.innerHTML = players.map((p, i) => `<div class="w-12 h-12 bg-green-500 text-white rounded-xl flex flex-col items-center justify-center font-black shadow-lg animate-bounce text-[10px]"><span class="opacity-70">#${i+1}</span><span>${p.seatNo}號</span></div>`).join('');
                    document.getElementById('modal-footer').innerHTML = `<button onclick="closeModal(); startGameUI();" class="bg-green-600 text-white px-10 py-3 rounded-2xl font-black shadow-lg">進入遊戲！</button>`;
                }
            }, 100);
        }

        function startGameUI() {
            document.getElementById('setup-step-2').classList.add('screen-hidden');
            const gameScreen = document.getElementById('game-screen');
            gameScreen.classList.remove('screen-hidden');
            createBoard();
            updateUI();
            placeTokens();
        }

        // --- 核心遊戲邏輯 ---
        function createBoard() {
            const board = document.getElementById('game-board'); board.innerHTML = '';
            const posMap = [];
            for(let i=1; i<=6; i++) posMap.push({r:1, c:i}); for(let i=2; i<=5; i++) posMap.push({r:i, c:6});
            for(let i=6; i>=1; i--) posMap.push({r:6, c:i}); for(let i=5; i>=2; i--) posMap.push({r:i, c:1});
            posMap.forEach((pos, idx) => {
                const cell = document.createElement('div');
                cell.className = `cell cell-${idx} col-start-${pos.c} row-start-${pos.r} shadow-sm`;
                let type = "📚 題目";
                if(idx === 0) { type = "🚩 起點"; cell.classList.add('cell-0'); }
                else if(CHANCE_CELLS.includes(idx)) { type = "❓ 機會"; cell.classList.add('cell-chance'); }
                else if(FATE_CELLS.includes(idx)) { type = "✨ 命運"; cell.classList.add('cell-fate'); }
                cell.innerHTML = `<div class="mb-1 opacity-80 font-bold text-[11px] md:text-xs uppercase">${type}</div><div id="tokens-${idx}" class="flex flex-wrap justify-center gap-0.5"></div>`;
                board.appendChild(cell);
            });
        }

        function updateUI() {
            const stats = document.getElementById('player-stats');
            stats.innerHTML = [...players].sort((a,b) => b.score - a.score).map((p, idx) => `
                <div class="p-2 rounded-xl bg-gray-50 border-l-4 flex justify-between items-center shadow-sm" style="border-color: ${p.color}">
                    <span class="font-black text-[10px] text-gray-800">${p.seatNo}號</span>
                    <span class="bg-white px-2 py-0.5 rounded-full text-[10px] font-black shadow-sm">${p.score} 分</span>
                </div>
            `).join('');
            const p = players[currentPlayerIndex];
            const info = document.getElementById('current-player-info');
            info.innerText = `${p.seatNo}號`;
            info.style.backgroundColor = p.color;
        }

        function placeTokens() {
            for(let i=0; i<TOTAL_CELLS; i++) { const h = document.getElementById(`tokens-${i}`); if (h) h.innerHTML = ''; }
            players.forEach(p => {
                const h = document.getElementById(`tokens-${p.pos}`);
                if (h) { const t = document.createElement('div'); t.className = 'player-token'; t.style.backgroundColor = p.color; t.innerText = p.seatNo; h.appendChild(t); }
            });
        }

        function rollDice() {
            if (isRolling) return;
            const p = players[currentPlayerIndex];
            if (p.skipNextTurn) { p.skipNextTurn = false; showModal("暫停回合", `${p.seatNo}號 本回合停止一次！`, "bg-gray-500", nextTurn); return; }
            
            isRolling = true;
            const d = document.getElementById('dice'), res = document.getElementById('roll-result');
            d.classList.add('rolling'); res.innerText = "";
            setTimeout(() => {
                const roll = Math.floor(Math.random() * 6) + 1;
                d.classList.remove('rolling'); d.innerText = ['⚀','⚁','⚂','⚃','⚄','⚅'][roll-1];
                res.innerText = `${roll} 步`;
                p.pos = (p.pos + roll) % TOTAL_CELLS; placeTokens();
                setTimeout(() => handleCellLanding(p.pos), 600);
            }, 800);
        }

        function handleCellLanding(pos) {
            if (pos === 0) {
                showModal("🚩 起點", "路過起點，獎勵積分！<br><span class='text-2xl font-black text-green-600'>積分 +50</span>", "bg-green-500", () => { players[currentPlayerIndex].score += 50; nextTurn(); });
            } else if (CHANCE_CELLS.includes(pos)) {
                handleChanceEvent();
            } else if (FATE_CELLS.includes(pos)) {
                handleFateEvent();
            } else handleQuiz();
        }

        function handleQuiz() {
            const q = questionsPool[Math.floor(Math.random() * questionsPool.length)], p = players[currentPlayerIndex];
            let body = `<p class="text-lg mb-4 font-black text-gray-800">${q.q}</p><div class="grid gap-2">`;
            q.a.forEach((ans, i) => { body += `<button onclick="checkAnswer(${i}, ${q.correct})" class="w-full py-4 px-6 bg-indigo-50 hover:bg-indigo-100 border-2 border-indigo-100 rounded-2xl text-left font-black text-indigo-700 active:scale-95 transition-all">${i+1}. ${ans}</button>`; });
            body += `</div>`;
            showModal(`${p.seatNo}號 的大挑戰`, body, "bg-indigo-600", null, true);
        }

        window.checkAnswer = (choice, correct) => {
            if (choice === correct) { showModal("答對了！🎉", `<span class="text-3xl font-black text-green-600">+100 分</span>`, "bg-green-500", () => { players[currentPlayerIndex].score += 100; nextTurn(); }); }
            else { showModal("答錯了...😢", `<span class="text-3xl font-black text-red-600">-50 分</span>`, "bg-red-500", () => { players[currentPlayerIndex].score -= 50; nextTurn(); }); }
        };

        function handleChanceEvent() {
            let body = `<p class="mb-4 font-bold text-md text-gray-700">與系統猜拳！贏了獎勵 <span class="text-green-600">+150 分</span></p>`;
            body += `<div class="grid grid-cols-3 gap-2">
                <button onclick="playRPS(0)" class="rps-btn">✊</button>
                <button onclick="playRPS(1)" class="rps-btn">✋</button>
                <button onclick="playRPS(2)" class="rps-btn">✌️</button>
            </div>`;
            showModal("機會 ❓ 猜拳挑戰", body, "bg-yellow-500", null, true);
        }

        window.playRPS = (pChoice) => {
            const sChoice = Math.floor(Math.random() * 3);
            const icons = ["✊ 石頭", "✋ 布", "✌️ 剪刀"];
            const p = players[currentPlayerIndex];
            let resultText = `你出：${icons[pChoice]}<br>系統出：${icons[sChoice]}<br><br>`;
            if (pChoice === sChoice) resultText += `<span class="text-2xl font-black text-gray-600">平手！無事發生。</span>`;
            else if ((pChoice === 0 && sChoice === 2) || (pChoice === 1 && sChoice === 0) || (pChoice === 2 && sChoice === 1)) {
                resultText += `<span class="text-2xl font-black text-green-600">你贏了！ 積分 +150！</span>`;
                p.score += 150;
            } else resultText += `<span class="text-2xl font-black text-red-600">你輸了... 無事發生。</span>`;
            showModal("猜拳結果", resultText, "bg-indigo-600", nextTurn);
        };

        function handleFateEvent() {
            const p = players[currentPlayerIndex];
            const events = [
                { t: "幫忙班習作回辦公室，積分 +150 分！", action: () => { p.score += 150; nextTurn(); } },
                { t: "舉報有人上課說髒話，指定他扣除 150 分！", action: () => promptTargetSelect("扣除 150 分", (t) => { t.score -= 150; nextTurn(); }) },
                { t: "舉報有人上國文課桌上卻放英語課本！指定一位玩家下一輪暫停行動！", action: () => promptTargetSelect("暫停一回合", (t) => { t.skipNextTurn = true; nextTurn(); }) },
                { t: "友誼第一，和一位指定玩家平分分數！", action: () => promptTargetSelect("平均積分", (t) => { const avg = Math.floor((p.score + t.score) / 2); p.score = avg; t.score = avg; nextTurn(); }) },
                { t: "偷偷把營養午餐的螢光咖哩換掉，所有人向你致敬，每人各給你 50 分！", action: () => { players.forEach(o => { if(o.id !== p.id) { o.score -= 50; p.score += 50; } }); nextTurn(); } },
                { t: "突然出現小偷，閃身步偷走你 100 分。", action: () => { p.score -= 100; nextTurn(); } }
            ];
            const ev = events[Math.floor(Math.random() * events.length)];
            showModal("命運 ✨ 特別事件", ev.t, "bg-blue-600", ev.action);
        }

        function promptTargetSelect(label, callback) {
            const p = players[currentPlayerIndex], others = players.filter(o => o.id !== p.id);
            let body = `<p class="mb-3 font-bold text-gray-700 text-sm">請選擇對象 [${label}]：</p><div class="grid grid-cols-2 gap-2">`;
            others.forEach(o => { body += `<button onclick="executeTarget(${o.id})" class="p-2 border-2 rounded-xl font-black text-xs" style="border-color:${o.color}; color:${o.color}">${o.seatNo}號 (${o.score}分)</button>`; });
            body += `</div>`;
            window.tempCB = callback; showModal("選擇指定目標", body, "bg-gray-800", null, true);
        }

        window.executeTarget = (tid) => { closeModal(); if(window.tempCB) window.tempCB(players.find(o => o.id === tid)); };

        function nextTurn() { currentPlayerIndex = (currentPlayerIndex + 1) % players.length; isRolling = false; updateUI(); }
        
        function confirmEnd() { showModal("結算提醒", "確定要結束遊戲並結算最終名次嗎？", "bg-gray-700", endGame); }

        function endGame() {
            const scoreGroups = {}; 
            players.forEach(p => { if(!scoreGroups[p.score]) scoreGroups[p.score] = []; scoreGroups[p.score].push(p); });
            const tiedScores = Object.keys(scoreGroups).map(Number).filter(s => scoreGroups[s].length > 1).sort((a,b) => b-a);
            
            if (tiedScores.length > 0) {
                let tieBody = `<div class="flex flex-col items-center gap-4 py-6"><p class="text-indigo-600 font-black animate-pulse text-lg">⚖️ 同分抽籤決定名次中...</p><div class="space-y-3 w-full">${tiedScores.map(s => `<div class="p-3 bg-amber-50 rounded-xl border border-amber-200 tie-box"><div id="group-${s}" class="flex flex-wrap justify-center gap-2">${scoreGroups[s].map(p => `<div class="w-12 h-12 bg-white rounded-lg flex items-center justify-center font-black border shadow-sm">${p.seatNo}號</div>`).join('')}</div></div>`).join('')}</div></div>`;
                showModal("名次局部抽籤", tieBody, "bg-indigo-600", null, true);
                let shuffles = 0; const interval = setInterval(() => {
                    tiedScores.forEach(s => { const el = document.getElementById(`group-${s}`); if(!el) return; const items = Array.from(el.children).sort(() => Math.random() - 0.5); el.innerHTML = ''; items.forEach(it => el.appendChild(it)); });
                    if(++shuffles > 15) { clearInterval(interval); const finalOrder = []; const sorted = Object.keys(scoreGroups).map(Number).sort((a,b) => b-a); sorted.forEach(s => finalOrder.push(...scoreGroups[s].sort(() => Math.random() - 0.5))); setTimeout(() => renderFinal(finalOrder), 300); }
                }, 100);
            } else renderFinal([...players].sort((a, b) => b.score - a.score));
        }

        function renderFinal(rank) {
            const pCount = rank.length;
            let body = `<div class="text-left space-y-2">`;
            rank.forEach((p, idx) => {
                let prize = "😐 安全過關"; let color = "text-gray-400";
                if(idx === 0) { prize = `👑 <b>冠軍：【${rewardRankMap[1]}】</b>`; color = "text-green-600"; }
                else if(idx === 1) { prize = `🥈 <b>亞軍：【${rewardRankMap[2]}】</b>`; color = "text-blue-600"; }
                else if(idx === pCount - 1) { prize = `💀 <b>墊底：【${penaltyRankMap.last}】</b>`; color = "text-red-600"; }
                else if(pCount > 3 && idx === pCount - 2) { prize = `⚠️ <b>倒二：【${penaltyRankMap.secondLast}】</b>`; color = "text-orange-600"; }
                body += `<div class="p-3 border-2 rounded-2xl bg-white shadow-sm flex items-center justify-between" style="border-color:${p.color}"><div><h4 class="font-black text-xs">第 ${idx+1} 名 - ${p.seatNo}號</h4><p class="${color} text-[10px] mt-0.5">${prize}</p></div><div class="font-black text-xs text-indigo-500">${p.score}分</div></div>`;
            });
            body += `</div>`;
            const m = document.getElementById('modal-container');
            document.getElementById('modal-header').innerText = "🏆 最終結算清單";
            document.getElementById('modal-header').className = "p-4 text-white font-black text-center text-xl bg-gray-800";
            document.getElementById('modal-body').innerHTML = body;
            document.getElementById('modal-footer').innerHTML = `<button onclick="location.reload()" class="bg-indigo-600 text-white px-10 py-3 rounded-2xl font-black shadow-lg">回首頁再玩一次</button>`;
            m.classList.remove('hidden');
        }

        function showModal(title, content, headerClass, onClose, hideFooter = false) {
            const m = document.getElementById('modal-container');
            document.getElementById('modal-header').innerHTML = title;
            document.getElementById('modal-header').className = `p-4 text-white font-black text-center text-xl ${headerClass}`;
            document.getElementById('modal-body').innerHTML = content;
            const f = document.getElementById('modal-footer'); f.innerHTML = '';
            if (!hideFooter) { 
                const b = document.createElement('button'); 
                b.className = "bg-indigo-600 text-white px-8 py-2 rounded-xl font-black shadow-md"; 
                b.innerText = "確定"; 
                b.onclick = () => { m.classList.add('hidden'); if(onClose) onClose(); }; 
                f.appendChild(b); 
            }
            m.classList.remove('hidden');
        }
        function closeModal() { document.getElementById('modal-container').classList.add('hidden'); }
    </script>
</body>
</html>
