    <script>
        const initialRewards = ["糖果 5 顆", "免罰寫1次", "平時加5分"];
        let punishmentsPool = ["開合跳 10 次", "去任意其他組別進行飯撒", "講笑話(不可以冷場)", "放學前每一句話後面都要加「喵」", "唱一首兒歌"];
        
        const questionsPool = [
            { q: "下列「 」中的字，何組讀音兩兩相同？", a: ["「禁」錮／「禁」不住", "「喪」失／「喪」事 ", "「悶」悶不樂／天氣「悶」熱", "執「著」／「著」陸"], correct: 3 },
            { q: "大雄的中文書寫能力尚待加強，四個字形題只對了一題。請問他完全寫對的是下列何者？", a: ["手撩腳銬", "刮骨療毒", "官寮作風", "窮困遼倒"], correct: 1 },
            { q: "「損失是生活的代價，它同時也是諸多成長和收穫的泉源。」這句話有何涵義？", a: ["過多的損失造成無法挽回的悲劇", "自身的「悲劇」可以加速自身的成長", "要收穫必須付出相對應的代價", "成長的收穫就是不斷地付出"], correct: 1 },
            { q: "「有時候人慣於把自己局限在一個狹小的世界內。」這句話的涵義與下列哪個詞語意思相近？", a: ["離鄉背井", "無地自容", "以管窺天", "畫地自限"], correct: 3 },
            { q: "下列「 」中的字，何者當「動詞」用？", a: ["心靈的「枷」鎖", "「築」成一面牆 ", "「斗」室之中", "年「復」一年"], correct: 1 },
            { q: "「走生路，生而出新；走險路，險而出奇；走艱路，難而不俗。」此句使用結構相似的文句，接二連三表達同範圍、同性質的意念。下列何者也是使用相同的寫法？", a: ["比起我，到底誰更像是囚犯呢 ", "我全身的關節都受到病魔的「轄制」", "就像一個被判無期徒刑的犯人，不知何年何月才能重見「天日」", "腿不能行，肩不能舉，手不能彎"], correct: 3 },
            { q: "「一扇門關上時，另一扇卻開了，不過我們經常十分懊喪地久久望著這扇關了的門，而不見為我們敞開的那扇門。」這段話主要指出人經常會犯什麼樣的錯誤？", a: ["囿於所見", "作繭自縛", "自欺欺人", "猶豫不決"], correct: 0 },
            { q: "杏林子展現樂觀的心態，其突破生命考驗的態度，與下列何者不相同？", a: ["女藝人因拍戲遭火燒傷，堅強面對復健，甚至參加公益路跑", "多重障礙的莊馥華，克服有形的限制，透過特殊輔具創作動人的詩篇", "畫家謝坤山因意外而失去雙手，卻能以口作畫，成功找到自己的另一片天空", "表哥因為公職考試一再落榜，決定依賴父母在家當「啃老族」"], correct: 3},
            { q: "下列選項「 」中的詞語，何組前後意義相同？", a: ["這座城市的夜晚充滿了「繁華」，熱鬧非凡／他生來富貴，享盡「繁華」，中年卻家道中落", "阿偉跑步前沒做好暖身，導致膝「關節」受傷／他因企圖行賄打通「關節」而吃上官司」", "妹妹整天「沉溺」於電玩，成績一落千丈／「沉溺」在罪惡中無法自拔", "古代用「枷鎖」拘繫罪犯╱希望他能突破心靈的「枷鎖」"], correct: 2 },
            { q: "杏林子認為一個人只要能突破心靈的枷鎖，這個世界就再也沒有什麼能困得住他的了。可知杏林子希望人應要如何自處？", a: ["名韁利鎖", "樂天達觀", "瞻前顧後", "患得患失"], correct: 1},
            { q: "下列「 」中的字義，何者與「年復一年」中的「復」字相同？", a: ["收「復」失土", "死灰「復」燃", "「復」仇血恨", "恢「復」健康"], correct: 1 },
            { q: "下列文句，何者用字完全正確？", a: ["魔術師的表演精彩絕倫，讓臺下的觀眾看得瞋目結舌", "爺爺深受關節炎故疾的折磨，每逢陰雨天便無法下床", "獨自漫步時，突然聽見淒厲的叫聲，嚇得我心驚膽綻", "自從生一場大病後，原本開朗的姐姐便變得鬱鬱寡歡"], correct: 3 },
            { q: "「不讓自己的命運被疾病所『左右』」此段文字中「左右」是指「控制、支配」的意思。下列文句中的「左右」，何者也是相同的意思？", a: ["為了準備段考，班長預計在圖書館待到傍晚六點「左右」再回家 ", "真正成熟的人能夠獨立思考，而不會輕易被網路言論所「左右", "老闆在做出決策前，一定會先詢問「左右」親信，確保判斷萬無一失", "出門前媽媽叮嚀妹妹：過馬路時一定要看清「左右」來車，注意安全！"], correct: 1 },
            { q: "許多詞彙在經過時代演變後，會從原本指稱具體事物的「本義」，擴大引申為指稱抽象概念的「引申義」。下列文句「 」內的詞彙，何者不是「引申義」？ ", a: ["既然比賽「規矩」已擬定，大家就要保持運動員精神予以遵守", "工匠運用純熟高超的「陶冶」技術，打造出實用精美的器皿", "唯有突破世俗的「鐐銬」，我們才能看見自己內心真實的渴望", "警方加強巡邏後，這座公園「方圓」幾公里內的偷竊率大幅下降"], correct: 1 },
            { q: "下列詞語的前後關係何者和「枷鎖―桎梏」不相同？", a: ["剝奪―剝蝕", "轄制―限制 ", "沉溺―沉迷", "憔悴―疲憊"], correct: 0 },
            { q: "根據心囚一文，「心囚」所指的是下列哪一種人？", a: ["不能隨心所欲、行動自如的人", "全身關節都受到病魔轄制的人", "身體健康，心理卻不健全的人", "怪病纏身而需被禁錮在床的人"], correct: 2 },
            { q: "根據心囚一文，下列何者並非囚禁心靈的「枷鎖」？", a: ["沉溺在罪惡中無法自拔", "迷戀在情慾中無法脫身", "為名利權勢所左右而迷失自己", "腿不能行，肩不能舉，手不能彎"], correct: 3 },
            { q: "文章末段，杏林子以「比起我，到底誰更像是囚犯呢？」作結的用意為何？", a: ["用懸問促使讀者探究", "用提問引導文章方向", "用反問聚焦全文主旨", "用反問呼籲他人重視"], correct: 2 },
            { q: "關於心囚一文的寫作手法，下列何者敘述最正確？", a: ["全文皆採客觀記敘，不著重於議論", "援引他人經驗為例，來增加說服力", "透過排比論證，以凸顯文章的主旨", "首尾呼應，論證心態才是囚禁人生的關鍵"], correct: 3 },
            { q: "杏林子說：「一個人只要能突破心靈的枷鎖，這個世界就再也沒有什麼能困住他的了。」以下事例何者最可以用來說明這段話的道理？", a: ["愛迪生：曾不被看好，但在母親鼓勵下保持好奇心，歷經上千次實驗失敗仍不氣餒，最終發明電燈照亮世", "岳飛：面臨金軍大舉入侵，他秉持著精忠報國的滿腔愛國熱血與正義感，率領岳家軍浴血奮戰，建立赫赫戰功 ", "尼克‧胡哲：天生沒四肢曾想自殺，後轉念接受不完美，挑戰衝浪、潛水並到全球多國演講，證明心靈自由便無所限制", "諸葛亮：為了報答劉備的知遇之恩，一生鞠躬盡瘁，死而後已，即便明知北伐極度艱難，依然堅持原則、盡忠職守直到生命最後一刻"], correct: 2 }
        ];

        let players = [];
        let currentPlayerIndex = 0;
