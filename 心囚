                    </div>
                    <div id="reward-assignment" class="hidden space-y-2 p-3 bg-white rounded-xl border border-green-200 shadow-sm">
                        <div class="flex items-center gap-2 text-xs">
                            <span class="w-20 font-bold text-green-700">第一名:</span>
