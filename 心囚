                </div>
            </div>
        </div>
    </div>

    <!-- 彈窗系統 -->
    <div id="modal-container" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 modal-overlay">
        <div class="bg-white w-full max-w-lg rounded-3xl shadow-2xl overflow-hidden transform scale-100 transition-all">
