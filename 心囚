                    </div>
                </div>
                <button onclick="goToStep2()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-black py-4 rounded-2xl transition-all text-xl shadow-lg active:scale-95">
                    下一步：設定獎懲
                </button>
            </div>
        </div>

        <!-- 步驟二：獎懲分配 -->
